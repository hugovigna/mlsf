const N = 14;     // lignes
const M = 14;     // colonnes
const K = 14;     // régions
enum Zone = { B, C, A, D, F, E, G, J, I, H, L, ZM, ZK, ZN };
const region[N][M] = [
    [B, B, B, B, B, C, C, C, C, A, A, A, A, A],
    [B, B, B, B, B, C, C, D, D, D, A, A, A, A],
    [B, B, C, C, C, C, C, F, D, D, D, D, A, A],
    [E, E, C, C, C, C, C, F, D, D, D, D, D, G],
    [E, E, F, F, F, F, F, F, D, D, D, D, G, G],
    [E, F, F, F, F, F, F, F, F, F, D, J, J, G],
    [F, F, I, F, F, F, H, H, H, H, J, J, J, G],
    [F, F, I, I, F, F, H, H, L, L, J, J, J, G],
    [I, I, I, I, F, F, H, H, L, L, J, J, J, G],
    [I, I, I, I, I, I, H, H, L, L, J, J, J, J],
    [I, I, I, ZM, ZM, I, ZK, L, L, L, L, L, J, J],
    [I, I, ZM, ZM, ZM, ZK, ZK, L, L, L, L, L, J, J],
    [I, ZM, ZM, ZM, ZM, ZM, ZN, L, ZN, L, L, L, L, J],
    [I, ZM, ZM, ZM, ZM, ZN, ZN, ZN, ZN, L, L, L, L, J]
];

array row[Zone] : 1..N;
array col[Zone] : 1..M;

// au plus un chat par ligne et par colonne
constraint allDifferent(row[*]);
constraint allDifferent(col[*]);

// le chat de la région z est dans la région z
forall z in Zone, i in 1..N, j in 1..M {
    constraint region[i][j] != z -> not (row[z] = i and col[z] = j);
}

// pas deux chats voisins (en diagonale : lignes et colonnes sont distinctes)
forall z1 in Zone, z2 in Zone, i in 1..N, j in 1..M,
       k in (i - 1)..(i + 1), l in (j - 1)..(j + 1) {
    constraint z1 < z2 and k != i and l != j
               -> not (row[z1] = i and col[z1] = j and row[z2] = k and col[z2] = l);
}
