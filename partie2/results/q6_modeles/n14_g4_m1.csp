const N = 14;     // lignes
const M = 14;     // colonnes
const K = 14;     // régions
enum Zone = { C, B, A, D, H, E, G, F, ZN, I, ZK, J, L, ZM };
const region[N][M] = [
    [C, C, C, C, B, B, B, A, A, A, A, A, D, D],
    [C, C, C, B, B, B, B, A, A, A, A, D, D, D],
    [C, C, C, B, B, B, B, A, A, D, D, D, D, D],
    [C, C, C, H, E, E, E, E, E, D, D, D, D, D],
    [C, C, C, H, E, E, E, E, E, E, D, D, G, G],
    [C, H, H, H, F, F, F, F, E, D, D, G, G, G],
    [ZN, H, H, H, F, F, F, F, E, G, G, G, G, G],
    [ZN, ZN, H, H, H, F, F, F, F, G, G, I, G, G],
    [ZN, ZN, H, H, H, F, F, ZK, ZK, ZK, I, I, J, J],
    [ZN, ZN, ZN, ZN, ZN, ZN, ZN, ZK, ZK, ZK, I, I, J, J],
    [ZN, ZN, ZN, ZN, ZN, ZN, ZN, ZK, ZK, I, I, I, J, J],
    [ZN, L, ZN, ZN, ZM, ZM, ZK, ZK, ZK, ZK, J, J, J, J],
    [ZN, ZN, ZN, ZN, ZM, ZM, ZM, ZM, ZM, ZM, J, J, J, J],
    [ZN, ZN, ZN, ZN, ZN, ZN, ZN, ZM, ZM, ZM, J, J, J, J]
];

array row[Zone] : 1..N;
array col[Zone] : 1..M;

// au plus un chat par ligne et par colonne
constraint allDifferent(row[*]);
constraint allDifferent(col[*]);

// le chat de la région z est dans la région z
forall z in Zone, i in 1..N, j in 1..M {
    constraint region[i][j] != z -> not (row[z] = i and col[z] = j);
}

// pas deux chats voisins (en diagonale : lignes et colonnes sont distinctes)
forall z1 in Zone, z2 in Zone, i in 1..N, j in 1..M,
       k in (i - 1)..(i + 1), l in (j - 1)..(j + 1) {
    constraint z1 < z2 and k != i and l != j
               -> not (row[z1] = i and col[z1] = j and row[z2] = k and col[z2] = l);
}
