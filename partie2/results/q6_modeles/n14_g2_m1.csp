const N = 14;     // lignes
const M = 14;     // colonnes
const K = 14;     // régions
enum Zone = { D, B, C, A, F, G, E, I, H, J, ZK, L, ZM, ZN };
const region[N][M] = [
    [D, B, B, B, B, B, B, C, A, A, A, A, A, A],
    [D, D, B, B, B, B, C, C, A, A, A, A, A, A],
    [D, D, D, B, B, B, C, C, C, C, C, F, F, A],
    [D, D, B, B, B, B, C, C, C, C, F, F, G, G],
    [D, D, D, E, E, E, E, C, C, C, F, F, G, G],
    [D, D, D, E, E, E, C, C, C, F, F, F, G, G],
    [D, D, D, D, I, E, H, H, C, C, C, G, G, G],
    [D, D, D, D, I, I, H, H, H, C, C, C, J, J],
    [ZK, ZK, D, D, I, I, I, H, H, H, C, C, J, J],
    [ZK, ZK, I, I, I, I, I, I, H, H, C, L, J, J],
    [ZK, ZK, I, I, I, I, ZM, I, H, H, L, L, J, J],
    [ZK, ZK, ZN, ZN, I, I, ZM, ZM, H, L, L, L, L, L],
    [ZN, ZN, ZN, ZN, ZM, ZM, ZM, ZM, H, L, L, L, L, L],
    [ZN, ZN, ZN, ZN, ZN, ZN, ZM, ZM, L, L, L, L, L, L]
];

array row[Zone] : 1..N;
array col[Zone] : 1..M;

// au plus un chat par ligne et par colonne
constraint allDifferent(row[*]);
constraint allDifferent(col[*]);

// le chat de la région z est dans la région z
forall z in Zone, i in 1..N, j in 1..M {
    constraint region[i][j] != z -> not (row[z] = i and col[z] = j);
}

// pas deux chats voisins (en diagonale : lignes et colonnes sont distinctes)
forall z1 in Zone, z2 in Zone, i in 1..N, j in 1..M,
       k in (i - 1)..(i + 1), l in (j - 1)..(j + 1) {
    constraint z1 < z2 and k != i and l != j
               -> not (row[z1] = i and col[z1] = j and row[z2] = k and col[z2] = l);
}
