const N = 14;     // lignes
const M = 14;     // colonnes
const K = 14;     // régions
enum Zone = { A, B, C, E, D, F, I, G, H, ZK, J, ZM, L, ZN };
const region[N][M] = [
    [A, A, A, B, B, B, B, B, B, C, C, C, C, C],
    [A, A, B, B, B, B, B, E, E, C, C, C, C, C],
    [A, A, A, A, D, E, E, E, E, E, C, C, C, C],
    [A, A, D, D, D, E, E, E, E, C, C, C, C, C],
    [A, F, F, E, E, E, E, E, E, C, C, C, C, C],
    [F, F, F, I, I, I, I, I, I, C, C, C, G, G],
    [H, F, F, F, I, I, I, I, I, I, I, G, G, G],
    [H, H, H, H, I, I, I, I, I, I, I, G, G, G],
    [H, H, H, ZK, ZK, ZK, I, I, I, J, J, J, J, ZM],
    [H, ZK, H, ZK, ZK, ZK, L, I, J, J, J, J, ZM, ZM],
    [H, ZK, ZK, ZK, ZK, ZK, L, L, L, J, J, J, ZM, ZM],
    [ZK, ZK, ZK, ZK, ZK, ZK, L, L, L, L, J, J, ZM, ZM],
    [ZK, ZK, ZK, ZK, ZK, ZK, ZK, L, ZN, ZN, J, J, ZM, ZM],
    [ZK, ZK, ZK, ZK, ZK, ZK, ZN, ZN, ZN, ZN, ZN, J, J, ZM]
];

array cat[N][M] : bool;

// exactement un chat par ligne et par colonne (N = M = K)
forall i in 1..N { constraint exactlyOne(cat[i][*]); }
forall j in 1..M { constraint exactlyOne(cat[*][j]); }

// pas deux chats voisins (en diagonale : lignes et colonnes sont exclusives)
forall i in 1..(N - 1), j in 1..M, l in (j - 1)..(j + 1) {
    constraint l >= 1 and l <= M and l != j -> not (cat[i][j] and cat[i + 1][l]);
}

// au plus un chat par région : pas deux chats dans deux cases distinctes d'une même région
forall i in 1..N, j in 1..M, k in i..N, l in 1..M {
    constraint (k > i or l > j) and region[i][j] = region[k][l]
               -> not (cat[i][j] and cat[k][l]);
}
