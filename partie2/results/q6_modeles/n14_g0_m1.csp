const N = 14;     // lignes
const M = 14;     // colonnes
const K = 14;     // régions
enum Zone = { A, B, C, E, D, F, I, G, H, ZK, J, ZM, L, ZN };
const region[N][M] = [
    [A, A, A, B, B, B, B, B, B, C, C, C, C, C],
    [A, A, B, B, B, B, B, E, E, C, C, C, C, C],
    [A, A, A, A, D, E, E, E, E, E, C, C, C, C],
    [A, A, D, D, D, E, E, E, E, C, C, C, C, C],
    [A, F, F, E, E, E, E, E, E, C, C, C, C, C],
    [F, F, F, I, I, I, I, I, I, C, C, C, G, G],
    [H, F, F, F, I, I, I, I, I, I, I, G, G, G],
    [H, H, H, H, I, I, I, I, I, I, I, G, G, G],
    [H, H, H, ZK, ZK, ZK, I, I, I, J, J, J, J, ZM],
    [H, ZK, H, ZK, ZK, ZK, L, I, J, J, J, J, ZM, ZM],
    [H, ZK, ZK, ZK, ZK, ZK, L, L, L, J, J, J, ZM, ZM],
    [ZK, ZK, ZK, ZK, ZK, ZK, L, L, L, L, J, J, ZM, ZM],
    [ZK, ZK, ZK, ZK, ZK, ZK, ZK, L, ZN, ZN, J, J, ZM, ZM],
    [ZK, ZK, ZK, ZK, ZK, ZK, ZN, ZN, ZN, ZN, ZN, J, J, ZM]
];

array row[Zone] : 1..N;
array col[Zone] : 1..M;

// au plus un chat par ligne et par colonne
constraint allDifferent(row[*]);
constraint allDifferent(col[*]);

// le chat de la région z est dans la région z
forall z in Zone, i in 1..N, j in 1..M {
    constraint region[i][j] != z -> not (row[z] = i and col[z] = j);
}

// pas deux chats voisins (en diagonale : lignes et colonnes sont distinctes)
forall z1 in Zone, z2 in Zone, i in 1..N, j in 1..M,
       k in (i - 1)..(i + 1), l in (j - 1)..(j + 1) {
    constraint z1 < z2 and k != i and l != j
               -> not (row[z1] = i and col[z1] = j and row[z2] = k and col[z2] = l);
}
