const N = 14;     // lignes
const M = 14;     // colonnes
const K = 14;     // régions
enum Zone = { C, B, A, D, H, E, G, F, ZN, I, ZK, J, L, ZM };
const region[N][M] = [
    [C, C, C, C, B, B, B, A, A, A, A, A, D, D],
    [C, C, C, B, B, B, B, A, A, A, A, D, D, D],
    [C, C, C, B, B, B, B, A, A, D, D, D, D, D],
    [C, C, C, H, E, E, E, E, E, D, D, D, D, D],
    [C, C, C, H, E, E, E, E, E, E, D, D, G, G],
    [C, H, H, H, F, F, F, F, E, D, D, G, G, G],
    [ZN, H, H, H, F, F, F, F, E, G, G, G, G, G],
    [ZN, ZN, H, H, H, F, F, F, F, G, G, I, G, G],
    [ZN, ZN, H, H, H, F, F, ZK, ZK, ZK, I, I, J, J],
    [ZN, ZN, ZN, ZN, ZN, ZN, ZN, ZK, ZK, ZK, I, I, J, J],
    [ZN, ZN, ZN, ZN, ZN, ZN, ZN, ZK, ZK, I, I, I, J, J],
    [ZN, L, ZN, ZN, ZM, ZM, ZK, ZK, ZK, ZK, J, J, J, J],
    [ZN, ZN, ZN, ZN, ZM, ZM, ZM, ZM, ZM, ZM, J, J, J, J],
    [ZN, ZN, ZN, ZN, ZN, ZN, ZN, ZM, ZM, ZM, J, J, J, J]
];

array cat[N][M] : bool;

// exactement un chat par ligne et par colonne (N = M = K)
forall i in 1..N { constraint exactlyOne(cat[i][*]); }
forall j in 1..M { constraint exactlyOne(cat[*][j]); }

// pas deux chats voisins (en diagonale : lignes et colonnes sont exclusives)
forall i in 1..(N - 1), j in 1..M, l in (j - 1)..(j + 1) {
    constraint l >= 1 and l <= M and l != j -> not (cat[i][j] and cat[i + 1][l]);
}

// au plus un chat par région : pas deux chats dans deux cases distinctes d'une même région
forall i in 1..N, j in 1..M, k in i..N, l in 1..M {
    constraint (k > i or l > j) and region[i][j] = region[k][l]
               -> not (cat[i][j] and cat[k][l]);
}
